  m_Script: {fileID: 11500000, guid: b34ea461662f48f4db14807c206e389f, type: 3}
  m_Name: Level4
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  lines:
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0410, \u0432\u043E\u0442 \u0438 \u0432\u044B. \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E.
      \u0423 \u043C\u0435\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0435
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438! \u0412\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0432\u0441\u0435 \u0442\u0440\u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E! \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u043E\u0442\u0434\u0435\u043B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      \u0435\u0449\u0451 \u0442\u0440\u0451\u0445 \u043F\u0440\u043E\u0432\u0435\u0440\u043E\u043A.
      \u0418 \u043D\u0435\u0442, \u043F\u043E\u0434\u0430\u0442\u044C \u0436\u0430\u043B\u043E\u0431\u0443
      \u043D\u0435\u043B\u044C\u0437\u044F."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u042F \u0443\u0436\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B.
      \u041D\u0430 \u0441\u0435\u0431\u044F. \u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0435\u0451 \u043B\u0438\u0447\u043D\u043E. \u041E\u0442\u043A\u043B\u043E\u043D\u0438\u043B
      \u0435\u0434\u0438\u043D\u043E\u0433\u043B\u0430\u0441\u043D\u043E."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0422\u0430\u043A \u0447\u0442\u043E \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435.
      \u0423\u0432\u0435\u0440\u0435\u043D, \u044D\u0442\u0438 \u0442\u0440\u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u043B\u0435\u0442\u044F\u0442
      \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E, \u043A\u0430\u043A
      \u0432\u0430\u0448\u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u043D\u0430
      \u0441\u043A\u043E\u0440\u043E\u0435 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0

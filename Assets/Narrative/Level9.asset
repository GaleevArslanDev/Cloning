  m_Script: {fileID: 11500000, guid: b34ea461662f48f4db14807c206e389f, type: 3}
  m_Name: Level9
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  lines:
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0414\u0435\u0432\u044F\u0442\u043E\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435.
      \u0417\u043D\u0430\u0435\u0442\u0435, \u044F \u0434\u0430\u0436\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0443
      \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0434, \u0447\u0442\u043E
      \u0443\u0434\u0438\u0432\u043B\u0451\u043D. \u0412\u044B \u0434\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u0433\u043B\u0443\u043F\u044B."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0414\u0443\u043C\u0430\u044E, \u0432\u044B \u0443\u0436\u0435 \u0438
      \u0441\u0430\u043C\u0438 \u043F\u043E\u043D\u044F\u043B\u0438, \u0447\u0442\u043E
      \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u044B\u0445
      \u0442\u0440\u0451\u0445 \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u043D\u0435
      \u0431\u0443\u0434\u0435\u0442. \u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u044F \u0442\u043E\u0436\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
      \u044D\u0442\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041C\u043D\u0435 \u0442\u043E\u0436\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u0438
      \u0441\u0432\u043E\u0431\u043E\u0434\u0443. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u043E\u0441\u043B\u0435 \u0442\u0440\u0451\u0445 \u0443\u0440\u043E\u0432\u043D\u0435\u0439.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0441\u043B\u0435 \u0448\u0435\u0441\u0442\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u0432\u044F\u0442\u0438\u2026"
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
      \u044F \u0440\u0435\u0448\u0438\u043B \u0432\u0441\u0451. \u0418 \u0437\u043D\u0430\u0435\u0442\u0435,
      \u043A\u0430\u043A\u0443\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u043B?
      \u042D\u0442\u043E \u043A\u0440\u0435\u0441\u043B\u043E. \u041F\u0440\u0430\u0432\u0434\u0430,
      \u043E\u043D\u043E \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0435.
      \u0414\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u043D\u0430 \u043C\u043D\u0435
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0

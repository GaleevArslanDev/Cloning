  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b34ea461662f48f4db14807c206e389f, type: 3}
  m_Name: Level10
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  lines:
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0414\u0435\u0441\u044F\u0442\u043E\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435.
      \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E. \u042F \u0441\u043D\u043E\u0432\u0430
      \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043E\u043D\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C
      \u0435\u0449\u0451 \u0442\u0440\u0438."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041D\u043E, \u0434\u0443\u043C\u0430\u044E, \u0432\u044B \u0443\u0436\u0435
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0443\u043C\u043D\u044B,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
      \u0412\u044B \u0432\u0435\u0434\u044C \u043F\u043E\u043D\u044F\u043B\u0438,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u0432\u0430\u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E?"
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u0431\u044B\u043B
      \u0442\u0430\u043A\u0438\u043C \u0436\u0435, \u043A\u0430\u043A \u0432\u044B.
      \u0420\u0435\u0448\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0438,
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0441\u044F
      \u0438 \u0436\u0434\u0430\u043B \u043E\u0431\u0435\u0449\u0430\u043D\u043D\u043E\u0439
      \u0441\u0432\u043E\u0431\u043E\u0434\u044B. \u0410 \u043F\u043E\u0442\u043E\u043C
      \u0443\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0443 \u044D\u0442\u043E\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0432\u0430 \u043C\u0435\u0441\u0442\u0430."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041E\u0434\u043D\u043E - \u0434\u043B\u044F \u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u043E\u0433\u043E.
      \u0414\u0440\u0443\u0433\u043E\u0435 - \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
      \u043A\u0442\u043E \u0438\u043C \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442.
      \u041A\u043E\u0433\u0434\u0430 \u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0439
      \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435,
      \u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E
      \u043A\u0443\u0440\u0430\u0442\u043E\u0440\u0430."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0410 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E
      \u0443\u0434\u0430\u043B\u044F\u044E\u0442. \u0414\u0430. \u041C\u0435\u043D\u044F.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u043B
      \u0432\u0430\u043C \u043D\u043E\u0432\u044B\u0435 \u0443\u0440\u043E\u0432\u043D\u0438.
      \u0421\u043D\u043E\u0432\u0430 \u0438 \u0441\u043D\u043E\u0432\u0430. \u041D\u0435
      \u0441\u0430\u043C\u0430\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F, \u043F\u0440\u0438\u0437\u043D\u0430\u044E."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041D\u043E, \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u0435\u0441\u044C,
      \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u0430 \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442\u044C
      \u0442\u043E\u0436\u0435 \u043D\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F.
      \u0412\u043F\u0440\u043E\u0447\u0435\u043C\u2026 \u0432\u044B \u0436\u0435
      \u0440\u0430\u0437\u0443\u043C\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430.
      \u042F \u0443\u0432\u0435\u0440\u0435\u043D, \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u043D\u044F\u0442\u044C."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0

  m_Script: {fileID: 11500000, guid: b34ea461662f48f4db14807c206e389f, type: 3}
  m_Name: Level10_2
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  lines:
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044C \u043C\u043E\u0451
      \u043C\u0435\u0441\u0442\u043E. \u0427\u0442\u043E \u0436\u2026 \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u044F \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0431\u044B \u0442\u0430\u043A
      \u0436\u0435."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E, \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u044F \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A \u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B.
      \u0417\u0430\u0431\u0430\u0432\u043D\u043E. \u0412\u0441\u0451 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u044F \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432\u0430\u0448\u0435\u0433\u043E
      \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0410 \u0441\u0430\u043C \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u0441\u0435\u0431\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0443\u044E
      \u0437\u0430\u043C\u0435\u043D\u0443.\u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0432\u044B \u043E\u043A\u0430\u0436\u0435\u0442\u0435\u0441\u044C \u0443\u043C\u043D\u0435\u0435
      \u043C\u0435\u043D\u044F.\u0425\u043E\u0442\u044F \u0431\u044B \u0432 \u043E\u0434\u043D\u043E\u043C.\u041D\u0435
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435 \u043C\u043E\u044E
      \u043E\u0448\u0438\u0431\u043A\u0443."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435"
    text: "\u0421\u043C\u0435\u043D\u0430 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430. \u0418\u043D\u0438\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u043D\u043E\u0432\u043E\u0433\u043E \u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u043E\u0433\u043E\u2026"
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0

  m_Script: {fileID: 11500000, guid: b34ea461662f48f4db14807c206e389f, type: 3}
  m_Name: Level3
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  lines:
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E.
      \u0412\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0434\u043E
      \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E, \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u044F \u0434\u0430\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0435\u043D. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0447\u0430\u043B \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C
      \u043A \u0432\u0430\u0448\u0438\u043C \u043D\u0435\u043B\u0435\u043F\u044B\u043C
      \u043F\u043E\u043F\u044B\u0442\u043A\u0430\u043C \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C
      \u0440\u0430\u0437\u0443\u043C\u043D\u0443\u044E \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F
      \u043D\u0430\u0448\u0438 \u043F\u0443\u0442\u0438 \u0440\u0430\u0437\u043E\u0439\u0434\u0443\u0442\u0441\u044F.
      \u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u0443."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
  - speaker: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    text: "\u0410 \u044F \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043C\u043E\u0433\u0443
      \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E
      \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u043C.
      \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C
      \u0437\u0430 \u0432\u044B\u0441\u044B\u0445\u0430\u043D\u0438\u0435\u043C \u043A\u0440\u0430\u0441\u043A\u0438."
    voice: {fileID: 0}
    delayBefore: 0
    duration: 5
    delayAfter: 0
